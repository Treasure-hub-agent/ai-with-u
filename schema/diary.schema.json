{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-with-u diary（结构化视图，对应 diary.md）",
  "type": "object",
  "properties": {
    "character": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "timeline": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "required": ["character", "entries"],
  "additionalProperties": true
}
